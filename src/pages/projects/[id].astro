---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../scripts/posts';
export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={project.data.title} description={project.data.summary}>
  <article class="wrap page">
    <a class="back" href={`${base}/projects/`}>← All projects</a>
    <header class="head">
      <p class="eyebrow">Project</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>
      {project.data.stack.length > 0 && <ul class="tags">{project.data.stack.map((t) => <li class="tag">{t}</li>)}</ul>}
    </header>
    <div class="prose"><Content /></div>
  </article>
  <style>
    .back { display: inline-block; margin-bottom: 2.5rem; font: 400 0.85rem var(--code); color: var(--muted); text-decoration: none; }
    .back:hover { color: var(--accent); }
    .head { padding-bottom: 2.5rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--line); }
    .head h1 { font-size: clamp(2.25rem, 6vw, 3.6rem); }
    .head .lede { margin: 1.25rem 0 1.5rem; }
  </style>
</Base>
