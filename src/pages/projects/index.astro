---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../scripts/posts';
const projects = await getProjects();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Projects" description="Things I have built.">
  <div class="wrap wide page">
    <p class="eyebrow">Work</p>
    <h1>Projects</h1>
    <p class="lede">Things I have built, broken and rebuilt.</p>
    <ul class="cards">
      {projects.map((p) => (
        <li>
          <article class="card">
            <h3><a href={`${base}/projects/${p.id}/`}>{p.data.title}</a></h3>
            <p class="desc">{p.data.summary}</p>
            <div class="foot">
              {p.data.stack.length > 0 ? <ul class="tags">{p.data.stack.map((t) => <li class="tag">{t}</li>)}</ul> : <span />}
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</Base>
