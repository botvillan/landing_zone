---
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { getProjects } from '../../scripts/posts';
const projects = await getProjects();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Projects" description="Pipelines, automations and homelab builds by Samuel Aravinth.">
  <div class="wrap wide page">
    <p class="eyebrow">Work</p>
    <h1>Projects</h1>
    <p class="lede">Pipelines, automations and homelab builds. Most of them were broken at least once.</p>
    <ul class="cards">
      {projects.map((p) => (
        <li>
          <article class="card">
            <Cover entry={p} />
            <div class="body">
              <h3><a href={`${base}/projects/${p.id}/`}>{p.data.title}</a></h3>
              {p.data.summary && <p class="desc">{p.data.summary}</p>}
              <div class="foot">
                {p.data.stack.length > 0 ? <ul class="tags">{p.data.stack.slice(0, 4).map((t) => <li class="tag">{t}</li>)}</ul> : <span />}
                <span class="arrow" aria-hidden="true">→</span>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</Base>
