---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { getPosts } from '../scripts/posts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <canvas id="network" aria-hidden="true"></canvas>
  <section class="hero">
    <div class="avatar">
      {site.photo ? <img src={`${base}/${site.photo}`} alt="" width="176" height="176" /> : <span aria-hidden="true">{site.initials}</span>}
    </div>
    <h1>Hi, I'm {site.name}</h1>
    <p class="role">
      <span class="visually-hidden">{site.phrases.join(', ')}</span>
      <span aria-hidden="true"><span data-phrases={JSON.stringify(site.phrases)}>{site.phrases[0]}</span><span class="caret"></span></span>
    </p>
    <p class="skills">{site.skills.join(' | ')}</p>
    <div class="actions">
      <a class="btn primary" href={`${base}/blog/`}>Read the blog</a>
      <a class="btn" href={`${base}/projects/`}>See projects</a>
    </div>
  </section>
  <section class="latest">
    <div class="wrap">
      <h2>Latest posts</h2>
      <PostList posts={posts} />
    </div>
  </section>
  <script>
    import '../scripts/network';
    import '../scripts/typer';
  </script>
  <style>
    #network { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; }
    .hero { position: relative; z-index: 1; min-height: calc(100svh - 4.25rem); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem 1rem 3rem; }
    .avatar { width: 11rem; height: 11rem; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: var(--raised); border: 2px solid var(--amber); margin-bottom: 1.75rem; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .avatar span { font: 700 3.5rem var(--display); color: var(--amber); }
    .role { font: 600 clamp(1.4rem, 3.5vw, 1.9rem)/1.3 var(--display); margin: 1rem 0 0; min-height: 1.3em; }
    .caret { display: inline-block; width: 2px; height: 1em; margin-left: 3px; vertical-align: -0.12em; background: var(--amber); animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .caret { display: none; } }
    .skills { color: var(--muted); margin: 0.75rem 0 2rem; }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
    .btn { padding: 0.7rem 1.4rem; border-radius: 8px; border: 1px solid var(--muted); background: var(--ink); color: var(--text); font-weight: 600; text-decoration: none; }
    .btn:hover { border-color: var(--amber); color: var(--amber); }
    .btn.primary { background: var(--amber); border-color: var(--amber); color: var(--ink); }
    .btn.primary:hover { background: #ffcd70; color: var(--ink); }
    .latest { position: relative; z-index: 1; background: var(--ink); padding-block: 3.5rem; border-top: 1px solid var(--line); }
    .latest h2 { margin-bottom: 1.25rem; }
  </style>
</Base>
