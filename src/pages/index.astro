---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../config';
import { getPosts } from '../scripts/posts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getPosts()).slice(0, 3);
---
<Base>
  <canvas id="network" aria-hidden="true"></canvas>
  <section class="hero">
    <div class="avatar">
      {site.photo ? <img src={`${base}/${site.photo}`} alt="" width="160" height="160" /> : <span aria-hidden="true">{site.initials}</span>}
    </div>
    <p class="pill"><span class="live" aria-hidden="true"></span>{site.skills.join(' · ')}</p>
    <p class="hi">Hi, I'm</p>
    <h1><span class="grad">{site.name}</span></h1>
    <p class="role">
      <span class="visually-hidden">{site.phrases.join(', ')}</span>
      <span aria-hidden="true"><span data-phrases={JSON.stringify(site.phrases)}>{site.phrases[0]}</span><span class="caret"></span></span>
    </p>
    <div class="actions">
      <a class="btn primary" href={`${base}/blog/`}>Read the blog <span aria-hidden="true">→</span></a>
      <a class="btn" href={`${base}/projects/`}>See projects</a>
    </div>
    {site.motto && <p class="motto"><span aria-hidden="true">“</span>{site.motto}<span aria-hidden="true">”</span></p>}
  </section>
  {posts.length > 0 && (
    <section class="latest">
      <div class="wrap wide">
        <div class="bar">
          <div>
            <p class="eyebrow">Writing</p>
            <h2>Latest posts</h2>
          </div>
          <a class="all" href={`${base}/blog/`}>All posts →</a>
        </div>
        <PostList posts={posts} />
      </div>
    </section>
  )}
  <script>
    import '../scripts/network';
    import '../scripts/typer';
  </script>
  <style>
    #network { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; }
    .hero { position: relative; z-index: 1; min-height: calc(100svh - 3.75rem); display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 3rem 1rem 4rem; }
    .avatar { width: 7.5rem; height: 7.5rem; border-radius: 50%; overflow: hidden; display: grid; place-items: center; background: var(--raised); border: 1px solid var(--line-strong); box-shadow: 0 0 0 6px rgba(142, 162, 255, 0.06), 0 20px 60px -10px rgba(142, 162, 255, 0.35); margin-bottom: 2rem; }
    .avatar img { width: 100%; height: 100%; object-fit: cover; }
    .avatar span { font: 600 2.5rem var(--display); letter-spacing: -0.04em; background: linear-gradient(135deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pill { display: inline-flex; align-items: center; gap: 0.6rem; margin: 0 0 1.75rem; padding: 0.45rem 0.9rem; border-radius: 999px; border: 1px solid var(--line-strong); background: rgba(9, 9, 11, 0.6); backdrop-filter: blur(8px); font: 400 0.8rem/1 var(--code); color: var(--muted); }
    .live { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #4ade80; box-shadow: 0 0 10px #4ade80; }
    .hi { margin: 0 0 0.5rem; font: 400 clamp(1rem, 2vw, 1.2rem)/1 var(--code); color: var(--muted); }
    .hero h1 { font-size: clamp(2.75rem, 8.5vw, 6rem); letter-spacing: -0.055em; line-height: 0.98; }
    .motto { margin: 2.75rem 0 0; max-width: 30rem; font-size: clamp(1rem, 1.8vw, 1.1rem); font-style: italic; color: var(--muted); padding: 0.6rem 1.1rem; border-left: 2px solid var(--accent); text-align: left; background: rgba(9, 9, 11, 0.5); backdrop-filter: blur(6px); border-radius: 0 10px 10px 0; }
    .motto span { color: var(--accent); font-style: normal; }
    .grad { background: linear-gradient(120deg, #fff 10%, var(--accent) 55%, var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .role { font: 400 clamp(1.15rem, 2.6vw, 1.5rem)/1.3 var(--code); color: var(--muted); margin: 1.25rem 0 2.5rem; min-height: 1.3em; }
    .caret { display: inline-block; width: 0.55em; height: 1.05em; margin-left: 4px; vertical-align: -0.15em; background: var(--accent); opacity: 0.8; animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .caret { display: none; } }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
    .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 1.4rem; border-radius: 999px; border: 1px solid var(--line-strong); background: rgba(9, 9, 11, 0.6); backdrop-filter: blur(8px); color: var(--text); font-weight: 500; font-size: 0.95rem; text-decoration: none; transition: border-color 0.2s, background 0.2s, transform 0.2s; }
    .btn:hover { color: var(--text); border-color: rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.06); }
    .btn.primary { background: var(--text); border-color: var(--text); color: var(--ink); }
    .btn.primary:hover { background: #fff; color: var(--ink); transform: translateY(-1px); box-shadow: 0 10px 30px -8px rgba(142, 162, 255, 0.6); }
    .latest { position: relative; z-index: 1; background: var(--ink); padding-block: clamp(4rem, 9vw, 6rem); border-top: 1px solid var(--line); }
    .bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 2rem; }
    .all { font: 400 0.85rem var(--code); color: var(--muted); text-decoration: none; white-space: nowrap; }
    .all:hover { color: var(--accent); }
    @media (max-width: 40rem) {
      .hero { padding-top: 2rem; }
      .avatar { width: 8.5rem; height: 8.5rem; }
      .avatar span { font-size: 2.9rem; }
      .pill { font-size: 0.8rem; line-height: 1.5; padding: 0.5rem 1rem; max-width: 19rem; flex-wrap: wrap; justify-content: center; text-align: center; border-radius: 18px; }
      .live { display: none; }
      .hero h1 { font-size: clamp(3rem, 14vw, 4.25rem); }
      .hi { font-size: 1.1rem; }
      .motto { font-size: 1.05rem; margin-top: 2.25rem; }
      .role { font-size: 1.35rem; }
      .actions { flex-direction: column; width: 100%; max-width: 22rem; }
      .btn { justify-content: center; font-size: 1.05rem; padding: 1rem 1.5rem; }
      .all { font-size: 0.95rem; }
    }
  </style>
</Base>
