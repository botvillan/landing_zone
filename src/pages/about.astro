---
import Base from '../layouts/Base.astro';
import { site } from '../config';
---
<Base title="About">
  <div class="wrap page">
    <p class="eyebrow">About</p>
    <h1>Hi, I'm {site.name}.</h1>
    <div class="prose" style="margin-top:2rem">{site.about.map((p) => <p>{p}</p>)}</div>
    {site.skills.length > 0 && <ul class="tags" style="margin-top:2.5rem">{site.skills.map((s) => <li class="tag">{s}</li>)}</ul>}
  </div>
</Base>
