---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../scripts/posts';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(post.data.date);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap page prose">
    <h1>{post.data.title}</h1>
    <p class="meta"><time datetime={post.data.date.toISOString()}>{date}</time></p>
    <Content />
    <p style="margin-top:3rem"><a href={`${base}/blog/`}>Back to all posts</a></p>
  </article>
</Base>
