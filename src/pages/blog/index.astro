---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../scripts/posts';
const posts = await getPosts();
---
<Base title="Blog" description="Notes on data engineering, automation and homelabbing by Samuel Aravinth.">
  <div class="wrap wide page">
    <p class="eyebrow">Writing</p>
    <h1>Blog</h1>
    <p class="lede">Notes from the pipeline: data engineering, automation and homelab build logs, including the bits that went wrong.</p>
    {posts.length > 0 ? <PostList posts={posts} feature /> : <p class="meta">No posts yet.</p>}
  </div>
</Base>
