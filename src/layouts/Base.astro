---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site } from '../config';
const { title, description = site.description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10152a" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={`${base}/rss.xml`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <footer>
      <span>© {new Date().getFullYear()} {site.name}</span>
      <a href={`${base}/rss.xml`}>RSS feed</a>
    </footer>
    <style>
      footer { position: relative; z-index: 2; display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem clamp(1rem, 4vw, 2.5rem); background: var(--ink); border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
    </style>
  </body>
</html>
