---
import { site } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const home = path === `${base}/` || path === base || path === '/';
const items = [['About', 'about'], ['Projects', 'projects'], ['Blog', 'blog'], ['Contact', 'contact']];
---
<header>
  <div class="inner">
    <a class="brand" href={`${base}/`} aria-label={`${site.name}, home`}>
      <span class="mark" aria-hidden="true">{site.initials}</span>
      {!home && <span class="name" aria-hidden="true">{site.name}</span>}
    </a>
    <nav aria-label="Main">
      {items.map(([label, slug]) => {
        const href = `${base}/${slug}/`;
        return <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
</header>
<style>
  header { position: sticky; top: 0; z-index: 20; background: rgba(9, 9, 11, 0.7); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid var(--line); }
  .inner { width: min(100% - 2rem, var(--wide)); margin-inline: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1.5rem; padding-block: 0.75rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.7rem; color: var(--text); text-decoration: none; }
  .mark { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 10px; font: 700 0.9rem/1 var(--display); letter-spacing: -0.04em; color: var(--ink); background: linear-gradient(135deg, var(--accent), var(--accent-2)); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.12) inset, 0 6px 20px -6px rgba(142, 162, 255, 0.7); transition: transform 0.25s, box-shadow 0.25s; }
  .brand:hover .mark { transform: rotate(-6deg) scale(1.05); box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.2) inset, 0 8px 26px -6px rgba(142, 162, 255, 0.9); }
  .name { font: 600 1rem var(--display); letter-spacing: -0.02em; }
  nav { display: flex; gap: 0.25rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.925rem; padding: 0.4rem 0.8rem; border-radius: 999px; transition: color 0.2s, background 0.2s; }
  nav a:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  nav a[aria-current] { color: var(--text); background: rgba(255, 255, 255, 0.08); }
  @media (prefers-reduced-motion: reduce) { .mark, .brand:hover .mark { transition: none; transform: none; } }
  @media (max-width: 40rem) {
    .inner { flex-wrap: nowrap; gap: 0.75rem; padding-block: 0.65rem; }
    .mark { width: 2.4rem; height: 2.4rem; font-size: 0.95rem; flex-shrink: 0; }
    .name { display: none; }
    nav { gap: 0; }
    nav a { font-size: 0.98rem; padding: 0.5rem 0.6rem; }
  }
  @media (max-width: 22.5rem) {
    nav a { font-size: 0.9rem; padding: 0.45rem 0.42rem; }
  }
</style>
