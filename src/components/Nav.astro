---
import { site } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const items = [['About', 'about'], ['Projects', 'projects'], ['Blog', 'blog'], ['Contact', 'contact']];
---
<header>
  <div class="inner">
    <a class="brand" href={`${base}/`}><span class="dot" aria-hidden="true"></span>{site.name}</a>
    <nav aria-label="Main">
      {items.map(([label, slug]) => {
        const href = `${base}/${slug}/`;
        return <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
</header>
<style>
  header { position: sticky; top: 0; z-index: 20; background: rgba(9, 9, 11, 0.7); backdrop-filter: saturate(160%) blur(14px); -webkit-backdrop-filter: saturate(160%) blur(14px); border-bottom: 1px solid var(--line); }
  .inner { width: min(100% - 2rem, var(--wide)); margin-inline: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1.5rem; padding-block: 0.85rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; font: 600 1.05rem var(--display); letter-spacing: -0.02em; color: var(--text); text-decoration: none; }
  .dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); box-shadow: 0 0 12px rgba(142, 162, 255, 0.7); }
  nav { display: flex; gap: 0.25rem; }
  nav a { color: var(--muted); text-decoration: none; font-size: 0.925rem; padding: 0.4rem 0.8rem; border-radius: 999px; transition: color 0.2s, background 0.2s; }
  nav a:hover { color: var(--text); background: rgba(255, 255, 255, 0.05); }
  nav a[aria-current] { color: var(--text); background: rgba(255, 255, 255, 0.08); }
  @media (max-width: 30rem) { nav a { padding-inline: 0.55rem; } }
</style>
