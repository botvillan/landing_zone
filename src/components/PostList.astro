---
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<ul class="rows">
  {posts.map((p) => (
    <li>
      <a class="title" href={`${base}/blog/${p.id}/`}>{p.data.title}</a>
      <p>{p.data.description}</p>
      <p class="meta"><time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>{p.data.tags.length > 0 && `, ${p.data.tags.join(', ')}`}</p>
    </li>
  ))}
</ul>
