---
import { readingTime, formatDate } from '../scripts/posts';
const { posts, feature = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ul class="cards">
  {posts.map((p, i) => {
    const featured = feature && i === 0;
    return (
      <li style={featured ? 'grid-column: 1 / -1' : undefined}>
        <article class={featured ? 'card featured' : 'card'}>
          {featured && <span class="badge">Latest</span>}
          <p class="meta"><time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time> · {readingTime(p.body)}</p>
          <h3><a href={`${base}/blog/${p.id}/`}>{p.data.title}</a></h3>
          <p class="desc">{p.data.description}</p>
          <div class="foot">
            {p.data.tags.length > 0 ? <ul class="tags">{p.data.tags.map((t) => <li class="tag">{t}</li>)}</ul> : <span />}
            <span class="arrow" aria-hidden="true">→</span>
          </div>
        </article>
      </li>
    );
  })}
</ul>
