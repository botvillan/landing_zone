---
// A post or project thumbnail: the cover image if there is one, otherwise generated artwork.
import { Image } from 'astro:assets';
import { coverOf, artSvg, themeOf } from '../scripts/media';
const { entry, eager = false, sizes = '(max-width: 40rem) 100vw, (max-width: 72rem) 50vw, 400px', label = true, class: cls } = Astro.props;
const cover = coverOf(entry);
const theme = themeOf(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = cover?.type === 'url' && cover.src.startsWith('/') && !cover.src.startsWith('//') ? `${base}${cover.src}` : cover?.src;
---
<div class:list={['cover', `t-${theme}`, cls]}>
  {cover?.type === 'local' ? (
    <Image src={cover.src} alt="" widths={[480, 800, 1200, 1600]} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  ) : cover?.type === 'url' ? (
    <img src={url as string} alt="" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (
    <Fragment set:html={artSvg(entry)} />
  )}
  {label && !cover && <span class="kind">{theme}</span>}
</div>
<style>
  .cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 12px; background: var(--raised); border: 1px solid var(--line); isolation: isolate; }
  .cover :global(img), .cover :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .cover::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(9, 9, 11, 0.35)); pointer-events: none; }
  .kind { position: absolute; left: 0.75rem; bottom: 0.7rem; z-index: 1; font: 500 0.7rem/1 var(--code); text-transform: uppercase; letter-spacing: 0.12em; color: #fff; padding: 0.4rem 0.6rem; border-radius: 999px; background: rgba(9, 9, 11, 0.55); backdrop-filter: blur(6px); border: 1px solid rgba(255, 255, 255, 0.12); }
  @media (prefers-reduced-motion: reduce) { .cover :global(img), .cover :global(svg) { transition: none; } }
</style>
